<atom:ControlThemesProvider xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:atom="https://atomui.net"
                            x:Class="AtomUI.Labs.Controls.ImageGallery.ImageGalleryThemesProvider"
                            Id="AtomUI.Labs.Controls.ImageGallery"
                            x:ClassModifier="internal">
    <atom:ControlThemesProvider.ControlThemes>
        <ResourceInclude Source="Themes/ImageGalleryThemes.axaml" />
    </atom:ControlThemesProvider.ControlThemes>
</atom:ControlThemesProvider>
