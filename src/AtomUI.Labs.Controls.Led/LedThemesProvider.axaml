<atom:ControlThemesProvider xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:atom="https://atomui.net"
                            x:Class="AtomUI.Labs.Controls.Led.LedThemesProvider"
                            Id="AtomUI.Labs.Controls.Led"
                            x:ClassModifier="internal">
    <atom:ControlThemesProvider.ControlThemes>
        <ResourceInclude Source="Themes/LedThemes.axaml" />
    </atom:ControlThemesProvider.ControlThemes>
</atom:ControlThemesProvider>
